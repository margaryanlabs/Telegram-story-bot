{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "ignoreCommand": "exit 1",
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/veto-gateway.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/veto-setup(?:\\.html|\\.js|\\.css)$",
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "Referrer-Policy": "no-referrer",
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "X-Content-Type-Options": "nosniff",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
      },
      "continue": true
    },
    {
      "src": "/studio\\.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/relay\\.html",
      "headers": {
        "Cache-Control": "public, max-age=300, stale-while-revalidate=86400",
        "Referrer-Policy": "no-referrer",
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "X-Content-Type-Options": "nosniff",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "/api/relay-bootstrap",
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "Referrer-Policy": "no-referrer",
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/app\\.js",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/privacy\\.js",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/app\\.css",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/api/([^/]+)$",
      "dest": "/api/veto-gateway.js?route=$1"
    },
    {
      "src": "^/$",
      "dest": "/public/studio.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/public/$1"
    }
  ]
}
