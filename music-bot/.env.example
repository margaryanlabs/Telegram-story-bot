# Configure these on a private VPS or secret manager; never commit actual values.
# Obtain a SEPARATE music bot from @BotFather, not the VETOGRAM messaging bot.
VETOGRAM_MUSIC_BOT_TOKEN=REPLACE_IN_SECRET_ENV
VETOGRAM_MUSIC_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
VETOGRAM_MUSIC_WEBHOOK_URL=https://YOUR_HTTPS_HOST/telegram/music-webhook
