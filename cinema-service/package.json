{
  "name": "@vetogram/cinema-service",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "import": "node import.mjs",
    "migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f sql/001_cinema.sql && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f sql/002_source_variants.sql",
    "test": "node --test tests/*.test.mjs",
    "discover": "node discover-kinobox.mjs",
    "studios:export": "node export-studio.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
